# Copy to .env — loaded by the server via `node --env-file`.
PORT=4000
# 32+ random chars. Encrypts channel credentials at rest (AES-256-GCM). Rotate = re-enter creds.
RUNHQ_SECRET=change-me-to-a-long-random-string
# Where the SQLite file lives. A relative path is resolved against packages/server,
# so it points at the same file no matter which directory you run from.
RUNHQ_DB_PATH=./data/marketing.db
# Public URL of this server, used in the SDK install snippet
RUNHQ_PUBLIC_URL=http://localhost:4000
# Hours between automatic channel syncs (0 disables)
RUNHQ_SYNC_INTERVAL_HOURS=6
